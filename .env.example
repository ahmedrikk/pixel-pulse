# These two Supabase values are intentionally public browser configuration.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key
VITE_TURNSTILE_SITE_KEY=your-public-turnstile-site-key

# Server-only values. Configure them in Vercel/Supabase; never prefix them VITE_.
SUPABASE_PROJECT_ID=your-project-ref
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_SERVICE_KEY=your-service-role-key
UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-server-only-upstash-token
# Vercel Marketplace may inject the equivalent KV_REST_API_URL/KV_REST_API_TOKEN names.
AUTH_IDENTIFIER_SECRET=generate-at-least-32-random-bytes
ALLOWED_WEB_ORIGINS=https://your-production-domain.example
CRON_SECRET=generate-a-long-random-value
RAWG_API_KEY=your-rawg-key
STEAM_API_KEY=your-steam-key
PANDASCORE_API_KEY=your-pandascore-key
GROQ_API_KEY=your-groq-key
GEMINI_API_KEY=your-gemini-key
KIMI_API_KEY=your-kimi-key
YOUTUBE_API_KEY=your-youtube-key
