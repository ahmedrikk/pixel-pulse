# These two Supabase values are intentionally public browser configuration.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key
VITE_TURNSTILE_SITE_KEY=your-public-turnstile-site-key

# Server-only values. Configure them in Vercel/Supabase; never prefix them VITE_.
SUPABASE_PROJECT_ID=your-project-ref
SUPABASE_SERVICE_KEY=your-service-role-key
CRON_SECRET=generate-a-long-random-value
RAWG_API_KEY=your-rawg-key
STEAM_API_KEY=your-steam-key
PANDASCORE_API_KEY=your-pandascore-key
GROQ_API_KEY=your-groq-key
GEMINI_API_KEY=your-gemini-key
KIMI_API_KEY=your-kimi-key
YOUTUBE_API_KEY=your-youtube-key
